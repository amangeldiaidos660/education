  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node", "mocha", "chai"],
    "strict": true
  },
  "include": ["scripts/**/*.ts", "tests/**/*.ts"]
}
