{
  "expo": {
    "name": "Söz Bricks",
    "slug": "soz-bricks",
    "scheme": "sozbricks",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#081c33",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.amangeldiaidos.sozbricks",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen",
      "expo-asset",
      "expo-web-browser"
    ],
    "owner": "amangeldiaidos",
    "extra": {
      "eas": {
        "projectId": "c6985c14-6090-4298-80c9-e2d1d9ce3da6"
      }
    }
  }
}
